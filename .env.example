# ID da planilha do Google Sheets (encontrado na URL: /spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Porta do servidor (padrão: 3000)
PORT=3000

# URL pública do Web App do Google Apps Script (deploy "Anyone, even anonymous")
# Usada pela tool acionar_automacao_planilha para disparar automações na planilha.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/XXXXX/exec

# Token compartilhado com o doPost() do Apps Script — barra chamadas não autorizadas.
# IMPORTANTE: em produção, prover via Secret Manager (não env var em texto limpo).
APPS_SCRIPT_TOKEN=replace_me
